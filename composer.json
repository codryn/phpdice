{
    "name": "codryn/phpdice",
    "description": "A comprehensive PHP library for parsing and rolling dice expressions for tabletop RPG systems",
    "type": "library",
    "license": "MIT",
    "keywords": ["dice", "rpg", "parser", "roller", "tabletop", "gaming", "d20", "dice notation"],
    "authors": [
        {
            "name": "PHPDice Contributors",
            "email": "info@codryn.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PHPDice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPDice\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover=coverage.xml",
        "test-coverage-html": "phpunit --coverage-html coverage/html",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse -c phpstan.neon",
        "fix-line-endings": "./scripts/fix-line-endings.sh",
        "run-examples": "./scripts/run-examples.sh",
        "verify-strict-types": "./scripts/verify-strict-types.sh",
        "ci": [
            "@fix-line-endings",
            "@test-coverage-html",
            "@cs-check",
            "@analyse",
            "@verify-strict-types",
            "@run-examples"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
